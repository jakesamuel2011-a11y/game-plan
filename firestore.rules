// Firestore security rules for Jake's Game Plan.
// Paste into Firebase Console ▸ Firestore Database ▸ Rules ▸ Publish.
// Meaning: ONLY Jake's and Christabel's accounts can read/write — even if
// someone else creates an account in the project, they get nothing.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null && request.auth.token.email in [
        // Replace with the two login emails (same as PEOPLE in firebase-config.js).
        // The live copy in the Firebase console has the real ones.
        'JAKE_LOGIN_EMAIL',
        'PARENT_LOGIN_EMAIL'
      ];
    }
    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
